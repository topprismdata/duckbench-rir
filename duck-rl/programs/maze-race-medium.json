{
 "format": "duck-program/2",
 "start": "go",
 "any": [
  {
   "if": "fallen",
   "go": "up",
   "except": [
    "up"
   ]
  }
 ],
 "nodes": {
  "go": {
   "skill": "walk",
   "params": {
    "vx": 0.19
   },
   "feed": {
    "vx": "choose(abs(path(0, 0)) > 0.8, 0.04, 0.19)",
    "wz": "clamp(1.5 * path(0, 0), -0.6, 0.6)"
   }
  },
  "up": {
   "skill": "get_up",
   "until": [
    {
     "if": "done",
     "go": "BACK"
    }
   ]
  }
 },
 "meta": {
  "title": "Arena bot: medium",
  "idea": "follow the shortest route round the walls (path), slowing in sharp turns"
 }
}
